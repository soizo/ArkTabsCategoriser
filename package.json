{
  "name": "ark-tabs-categoriser",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "prepare": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build && npm run build:firefox"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  }
}
